# Copy to .env and fill in only what you use. .env is gitignored.
# Never commit a real key, and never paste it into the browser UI.

# Optional: API-driven Gemini TTS (prompt 02). The manual Google AI Studio
# workflow needs no key. Get one from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: WhisperX / pyannote model access (prompt 03). Requires a free
# Hugging Face account, accepting the pyannote model conditions, and a read
# token. Step-by-step: docs/whisperx_local_guide.md#hugging-face-account-and-token
HF_TOKEN=
