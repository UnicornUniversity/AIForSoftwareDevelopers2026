# Copy this file to .env and fill in your own values. Never commit .env.
# The DEEPSEEK_API_KEY is optional: with no .env at all the server still starts
# and answers extractively from the passages ChromaDB returns.
#
# The one hard dependency is the ChromaDB store, built once (not by this
# server) with:
#   python week06/diabetes/ingest.py
# The backend only reads it and never ingests.

# Get a key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# OpenAI-compatible endpoint.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# HTTP server. The Vite dev server proxies /api here (see frontend/vite.config.js).
PORT=8789

# How long one answer may take. The link to DeepSeek has been measured between
# 13 and 46 seconds on this machine, so this budget sits above the common case.
# A call that overruns it falls back to an extractive answer; it is not an error.
LLM_TIMEOUT_MS=40000
# Retries live in the OpenAI SDK. Three attempts can stack up three timeouts,
# so the frontend waits 120 s; keep that above LLM_TIMEOUT_MS * (1 + retries).
LLM_MAX_RETRIES=1

# auto       - use DeepSeek when a key is present, otherwise extractive
# extractive - never call the model (useful for a fully offline demo)
ANSWER_MODE=auto

# Retrieval. Relative paths resolve from the backend folder.
CHROMA_DB=../../chroma
CHROMA_COLLECTION=diabetes

# The interpreter that has chromadb installed. Default: the repository-root
# .venv (Scripts/python.exe on Windows, bin/python elsewhere), then a venv in
# week06/diabetes or week06, then PATH.
# CHROMA_PYTHON=C:\path\to\.venv\Scripts\python.exe

# How long the Python bridge may take to open the store or answer a question.
CHROMA_TIMEOUT_MS=30000

TOP_K=5
MAX_QUESTION_CHARS=500

# Retrieval granularity: which passages reach the model.
#   section  - rank the top TOP_K sections and send only those.
#   document - rank TOP_K sections, then load every section of up to DOC_TOP_K
#              matched documents (parent-document retrieval, "small-to-big").
# `npm run compare` (in this folder) runs the same questions through both.
RETRIEVAL_MODE=section
DOC_TOP_K=3

# HTTPS interception (TLS-scanning antivirus, corporate proxy). Windows tools
# accept such a certificate because it is in the OS store; Node reads its own
# bundled CA list, so the model call fails with SELF_SIGNED_CERT_IN_CHAIN and
# the answer silently falls back to extractive. NODE_EXTRA_CA_CERTS must be set
# BEFORE Node starts: this file is loaded at runtime by config.js, which is too
# late for Node to read it. Use one of:
#   - Node >= 24: node --use-system-ca src/index.js   (trusts the OS store)
#   - setx NODE_EXTRA_CA_CERTS C:\path\to\proxy-root-ca.pem   (then reopen the terminal)
