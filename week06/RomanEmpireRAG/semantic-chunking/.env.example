# Semantic chunking -- optional integrations
#
# Copy to `.env` and fill in only what you need:
#
#   cp .env.example .env
#
# `.env` is gitignored (repo root .gitignore). This file is committed and must
# never contain a real secret. Every value below is also a safe default: with no
# `.env` at all, `semantic_chunking.py` runs fully offline using the local spaCy
# vectors (or a standard-library TF-IDF fallback if spaCy is absent).

# --- Core pipeline ----------------------------------------------------------
# auto | spacy | tfidf | sentence-transformers
#   auto                  use spaCy en_core_web_lg if importable, else tfidf
#   spacy                 local 300-d static word vectors, SIF-weighted
#   tfidf                 standard-library lexical fallback, no dependencies
#   sentence-transformers local transformer embeddings (downloads a model)
SEMANTIC_BACKEND=auto

# spaCy model used by the `spacy` backend.
SPACY_MODEL=en_core_web_lg

# Optional: a sentence-transformers model for the `st` backend.
# Downloaded on first use; no API key.
ST_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Directories are resolved relative to this folder; override only if needed.
# SEMANTIC_DATA_DIR=../data
# SEMANTIC_OUT_DIR=out

# --- DeepSeek (optional) ----------------------------------------------------
# https://platform.deepseek.com/api_keys
#
# IMPORTANT: DeepSeek's public API exposes chat completions, not an embeddings
# endpoint. It therefore cannot replace the vectorizer. In this project it is
# used where an LLM is genuinely better than a vector:
#
#   1. boundary adjudication -- confirm or reject the ambiguous breakpoints the
#      embedding pass proposes (`--deepseek-verify N`);
#   2. chunk headers -- a one-line topic label per chunk (`--deepseek-label`);
#   3. retrieval evaluation -- questions generated from a sample of chunks
#      (`--deepseek-questions N`).
#
# All three are opt-in and sampled, so a full corpus run stays affordable.
DEEPSEEK_API_KEY=

# OpenAI-compatible endpoint. https://api.deepseek.com/v1 also works.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# The network path to DeepSeek has been measured at 13-46 s per call, so the
# timeout is deliberately generous. Raise retries on a flaky link.
DEEPSEEK_TIMEOUT_S=90
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_TEMPERATURE=0.1

# How many boundary windows / chunks / questions to send in one request.
DEEPSEEK_BATCH_SIZE=8

# Hard cap on how many items any optional stage processes. This is the cost
# control: 0 disables the stage even when a key is present.
DEEPSEEK_MAX_ITEMS=40

# --- LlamaIndex alternative (optional) --------------------------------------
# `llamaindex_pipeline.py` runs the reference SemanticSplitterNodeParser over
# the same corpus and writes a comparable chunk file.
#
# Install (outside the stdlib-only core):
#   pip install -r requirements-optional.txt
#
# Embedding backend for LlamaIndex:
#   huggingface  local model, no key, downloads on first use (recommended)
#   openai       needs OPENAI_API_KEY below
LLAMAINDEX_EMBED_BACKEND=huggingface
LLAMAINDEX_EMBED_MODEL=BAAI/bge-small-en-v1.5
LLAMAINDEX_BREAKPOINT_PERCENTILE=95
LLAMAINDEX_BUFFER_SIZE=1
# SemanticSplitterNodeParser has no fixed-size packing; it breaks on semantic
# distance only. The report therefore leaves its size band wider than the
# recommendation and does not pretend it is size-constrained.

# Needed only when LLAMAINDEX_EMBED_BACKEND=openai.
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional gate for Hugging Face model downloads on a rate-limited network.
HF_TOKEN=
