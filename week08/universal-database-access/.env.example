# Optional real provider (DeepSeek, OpenAI-compatible endpoint).
# Copy to .env and fill locally. Never commit the filled .env.
DEEPSEEK_API_KEY=
UDA_MODEL=deepseek-chat
UDA_BASE_URL=https://api.deepseek.com

# Optional SQL Server metadata source (read-only login recommended).
# MS SQL Server 2025. Quote values that contain a backslash or spaces.
# Named instances: UDA_DB_SERVER='HOST\INSTANCE'
# Non-default port: UDA_DB_SERVER=HOST,PORT
UDA_DB_SERVER=localhost
UDA_DB_DATABASE=
UDA_DB_USER=
UDA_DB_PASSWORD=
UDA_DB_DRIVER='ODBC Driver 18 for SQL Server'
# Local development defaults; set TRUST_SERVER_CERTIFICATE=no with a trusted cert.
UDA_DB_ENCRYPT=yes
UDA_DB_TRUST_SERVER_CERTIFICATE=yes
