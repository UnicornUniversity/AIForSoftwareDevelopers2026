# UDA environment variables — placeholders only.
# Copy this file to .env and fill in real values. .env is Git-ignored.

# ---------------------------------------------------------------------------
# SQL Server database
# ---------------------------------------------------------------------------
# Host and port of the SQL Server instance. Use host ".\SQLEXPRESS" and leave
# the port empty for a local named instance reached through shared memory/named
# pipes. Use a TCP port (usually 1433) for a server with TCP enabled.
UDA_DB_HOST=localhost
UDA_DB_PORT=1433
UDA_DB_NAME=Northwind

# Authentication mode.
# SQL Server Authentication:
#   set UDA_DB_USERNAME and UDA_DB_PASSWORD, keep UDA_DB_TRUSTED_CONNECTION=false.
# Windows Integrated Authentication:
#   set UDA_DB_TRUSTED_CONNECTION=true and leave UDA_DB_USERNAME and
#   UDA_DB_PASSWORD empty.
UDA_DB_USERNAME=uda_readonly
UDA_DB_PASSWORD=change-me
UDA_DB_TRUSTED_CONNECTION=false

# ODBC driver. "ODBC Driver 18 for SQL Server" is recommended. Driver 17 is a
# fallback if installed. The 64-bit driver must match the 64-bit Python runtime.
UDA_DB_DRIVER=ODBC Driver 18 for SQL Server

# Encryption. Driver 18 encrypts by default. For a local SQL Server Express
# instance with a self-signed certificate, set TRUST_SERVER_CERTIFICATE=true
# deliberately for development only; do not use this in production.
UDA_DB_ENCRYPT=true
UDA_DB_TRUST_SERVER_CERTIFICATE=false

# Timeouts in seconds. CONNECTION_TIMEOUT is the login timeout; QUERY_TIMEOUT is
# applied to metadata queries.
UDA_DB_CONNECTION_TIMEOUT=15
UDA_DB_QUERY_TIMEOUT=30

# Optional defaults for later phases.
UDA_DB_SCHEMA=dbo
UDA_DB_ROW_LIMIT=1000

# ---------------------------------------------------------------------------
# LLM provider (DeepSeek is the default; Ollama is optional)
# ---------------------------------------------------------------------------
UDA_LLM_PROVIDER=deepseek
UDA_LLM_BASE_URL=https://api.deepseek.com/v1
UDA_LLM_MODEL=deepseek-chat
UDA_LLM_API_KEY=change-me
UDA_LLM_TEMPERATURE=0.0
UDA_LLM_MAX_TOKENS=1024

# ---------------------------------------------------------------------------
# Tracing (noop | langfuse)
# ---------------------------------------------------------------------------
UDA_TRACER=noop
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Opt-in integration tests. Set to 1 only with a configured read-only test DB.
UDA_DB_INTEGRATION=0
