{
  "schema_version": 1,
  "book": {
    "title": "The Shadowtail Kangaroo",
    "subtitle": "A Corpus Thesis",
    "author": "Garmoska",
    "institution": "",
    "date": "23 October 2026",
    "language": "en-GB",
    "plan": "mybook/book.json",
    "frontmatter": "mybook/frontmatter.json",
    "output": "mybook/output/thesis.docx"
  },
  "page": {
    "size": "A4",
    "margins_cm": {
      "top": 2.5,
      "bottom": 2.5,
      "left": 3.5,
      "right": 2.5
    }
  },
  "typography": {
    "body": {
      "font": "Times New Roman",
      "size_pt": 12,
      "line_spacing": 1.5,
      "alignment": "justify",
      "space_before_pt": 0,
      "space_after_pt": 6,
      "first_line_indent_cm": 0
    },
    "headings": {
      "font": "Arial",
      "bold": true,
      "color": "000000",
      "h1_size_pt": 16,
      "h2_size_pt": 13,
      "h1_space_before_pt": 18,
      "h1_space_after_pt": 12,
      "h2_space_before_pt": 12,
      "h2_space_after_pt": 6
    },
    "front_titles": {
      "font": "Arial",
      "size_pt": 14,
      "bold": true,
      "align": "center"
    },
    "quote": {
      "size_pt": 11,
      "italic": true,
      "indent_cm": 1.0
    },
    "provenance": {
      "size_pt": 9,
      "italic": true,
      "color": "444444"
    },
    "quotes": {
      "style": "english_smart",
      "punctuation": "outside"
    },
    "dashes": {
      "sentence": "em",
      "range": "en"
    },
    "nbsp_for_single_letters": false
  },
  "front_matter": {
    "title_page": true,
    "dedication": true,
    "declaration": true,
    "abstract": {
      "enabled": true,
      "title": "Abstract",
      "keywords_title": "Key words"
    },
    "anotace": {
      "enabled": true,
      "title": "Anotace",
      "keywords_title": "Klíčová slova"
    },
    "table_of_contents": {
      "enabled": true,
      "depth": 2,
      "title": "Contents"
    }
  },
  "body": {
    "page_numbers": {
      "enabled": true,
      "position": "bottom_center",
      "start_at_introduction": true
    },
    "running_header": {
      "enabled": false,
      "text": "book_title",
      "align": "right"
    },
    "chapter_start_new_page": true,
    "heading_numbering": {
      "enabled": true,
      "format": "decimal"
    },
    "references": {
      "enabled": true,
      "title": "References",
      "style": "harvard",
      "scope": "used",
      "sort": "id"
    },
    "captions": {
      "table": "above",
      "figure": "below",
      "numbering": "continuous"
    }
  },
  "corpus": {
    "folder": "coprus",
    "manifest": "coprus/manifest.json",
    "formats": ["docx", "pdf"]
  },
  "citations": {
    "in_text": "author_date"
  }
}
