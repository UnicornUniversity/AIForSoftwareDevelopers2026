# Copy this file to .env and fill in your own values. Never commit .env.
# Get a key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# OpenAI-compatible endpoint. DeepSeek also accepts https://api.deepseek.com/v1.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# HTTP server
PORT=3000

# Request budget. Keep DEEPSEEK_TIMEOUT_MS above the model's server-side timeout,
# and raise DEEPSEEK_MAX_RETRIES if the network path to the API is unreliable.
DEEPSEEK_TIMEOUT_MS=60000
DEEPSEEK_MAX_RETRIES=3
DEEPSEEK_MAX_CONCURRENCY=4

# Uncomment if HTTPS calls fail with a certificate verification error (a
# TLS-inspecting proxy on the network path needs its root CA trusted).
# NODE_EXTRA_CA_CERTS=C:\path\to\corporate-root-ca.pem
