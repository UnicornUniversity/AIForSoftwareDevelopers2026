# Sunset Chaser - backend settings
#
# Copy to `.env` and fill in the two API keys. `.env` is gitignored; this file is
# committed and must never contain real secrets.
#
#   cp .env.example .env
#
# Both keys are optional in the sense that the server always starts and always
# serves the terminator geometry. Without WINDY_API_KEY there are no cameras;
# without DEEPSEEK_API_KEY the ranking falls back to deterministic scoring.
#
# Every value below is a default, so an empty `.env` behaves exactly like this
# file. Out-of-range values are reported on stderr and replaced by the default
# rather than crashing the server.

# --- HTTP -------------------------------------------------------------------
PORT=8787

# --- Windy Webcams API v3 ---------------------------------------------------
# https://api.windy.com/keys  (free tier; image tokens expire after ~10 minutes)
WINDY_API_KEY=

# Windy caps `nearby` radius at 250 km.
NEARBY_RADIUS_KM=250

# Windy caps `limit` at 50.
CANDIDATE_LIMIT=50

# Number of Windy `nearby` probes placed along the sunset terminator arc.
# The arc is ~20,000 km and the max radius is 250 km, so gapless coverage would
# need ~41 calls; 20 weighted samples is the deliberate trade (see README).
TERMINATOR_SAMPLES=20

WINDY_TIMEOUT_MS=10000
WINDY_CONCURRENCY=4

# --- DeepSeek ---------------------------------------------------------------
# https://platform.deepseek.com/api_keys
# The backend uses the OpenAI-compatible endpoint, so only these three settings
# are needed. Current model ids are `deepseek-flash` and `deepseek-v4-pro`.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Hard cap on the curation call. The openai SDK defaults to 600s with 2 retries,
# which would hang a request for ten minutes on a stalled upstream.
#
# 45s is not arbitrary: `deepseek-flash` is a reasoning model, and a successful
# curation call has been measured between 13s and 46s depending on the link. A
# call that overruns the budget is not an error - the response falls back to the
# deterministic briefing and `meta.llm.error` reports why.
#
# The frontend's own request budget must stay above this number, or it will abort
# requests the backend was about to answer.
LLM_TIMEOUT_MS=45000

# The model reasons before it answers, and reasoning tokens are billed against
# `max_tokens`. At 1200 the entire budget went to thinking and content came back
# empty with finish_reason "length"; reasoning alone measured ~4000 tokens.
LLM_MAX_TOKENS=8000

# How many curated cameras the briefing asks for.
LLM_TOP_N=6

# How many ranked candidates are sent to the model to choose from.
LLM_CANDIDATES_OFFERED=12

# --- Result composition -----------------------------------------------------
# Cap on the ranked terminator list returned to the client.
MAX_PRIMARY_CAMERAS=12

# Cap on the big-city day-time fallback list. The fallback is always computed,
# so the spec's "always provide at least a few cameras" holds even when the
# terminator search comes back thin - the normal case over open ocean.
MAX_FALLBACK_CAMERAS=6

# Below this many terminator cameras, a warning explains that the rest of the
# arc is over water or ice. The fallback carries those requests.
MIN_PRIMARY_CAMERAS=6

# How many big cities the fallback may query. Capped tightly because these calls
# come out of the same Windy budget as the terminator sweep.
FALLBACK_CITY_COUNT=4

# --- Cache ------------------------------------------------------------------
# Deliberately under the free tier's ~10 minute image-token lifetime.
CACHE_TTL_SECONDS=300
