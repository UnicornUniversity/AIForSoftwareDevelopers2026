# Sunset Chaser - frontend settings
#
# Copy to `.env` if you need to point the app at a backend that is not on
# localhost:8787. The default (empty) value is correct for `npm run dev`, which
# proxies /api to the backend through Vite.
#
#   cp .env.example .env
#
# WARNING: only variables prefixed with VITE_ reach the browser, and everything
# that does reach the browser is visible to anyone who opens devtools. Never put
# an API key in this file - the Windy and DeepSeek keys belong in the backend's
# `.env`, which stays on the server.

# Base URL of the backend API. Empty means "same origin", which is what the Vite
# dev proxy provides. For a separately hosted backend, set the full origin:
#   VITE_API_BASE=http://localhost:8787
VITE_API_BASE=
