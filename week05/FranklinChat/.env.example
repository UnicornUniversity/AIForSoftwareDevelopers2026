# Copy this file to `.env` and fill in your real keys.
# `.env` is gitignored — never commit it.

# Pick a provider: "anthropic", "openai", or "deepseek"
PROVIDER=anthropic

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...

# Optional: override the DeepSeek model (default: deepseek-chat)
DEEPSEEK_MODEL=deepseek-v4-pro

# Optional: point at a local OpenAI-compatible server (LM Studio, Ollama).
# OPENAI_BASE_URL=http://localhost:1234/v1

# Server port
PORT=3001
