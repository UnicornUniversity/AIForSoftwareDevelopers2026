# Copy this file to .env and fill in your own values. Never commit .env.

# HTTP server (0 picks a free port)
PORT=3000
NODE_ENV=development

# Where the URL collection and the Markdown archive live. Relative paths are
# resolved against this folder.
DATA_DIR=data

# DeepSeek credentials for ranking and summaries. The key is optional: without
# it the digest still renders, using a deterministic ranking and the article
# text as the summary, and says so on the front page.
# Get a key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
