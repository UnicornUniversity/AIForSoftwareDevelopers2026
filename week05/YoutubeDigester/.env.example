# Copy this file to .env only if you prefer environment variables over
# settings.json. Every value is optional: the server boots without any of them.
# settings.json (gitignored) takes precedence over these values.

PORT=3001
NODE_ENV=development

# Optional overrides for local state
# DATA_DIR=data
# OUTPUT_DIR=output

# API keys (see settings.example.json for the same fields)
YOUTUBE_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Path to a Chrome/Chromium binary if Puppeteer's bundled browser is unavailable
# PUPPETEER_EXECUTABLE_PATH=
