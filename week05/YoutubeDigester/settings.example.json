{
  "youtube": {
    "apiKey": "",
    "maxVideos": 30,
    "timeoutMs": 15000,
    "retries": 1,
    "includeShorts": false,
    "minDurationSeconds": 120,
    "minTitleMatch": 0.5,
    "searchMaxResults": 50,
    "searchPages": 1,
    "playlistSearchMaxResults": 10
  },
  "deepseek": {
    "apiKey": "",
    "baseURL": "https://api.deepseek.com",
    "model": "deepseek-chat",
    "timeoutMs": 45000,
    "maxTokens": 8000,
    "temperature": 0.4
  },
  "transcript": {
    "languages": ["en"],
    "allowAutoGenerated": true,
    "concurrency": 3,
    "requestDelayMs": 250,
    "rateLimitRetries": 1,
    "timeoutMs": 20000,
    "maxChars": 200000
  },
  "llm": {
    "topicsMin": 5,
    "topicsMax": 12,
    "clusterMaxCharsPerVideo": 1500,
    "clusterMaxTotalChars": 30000,
    "chapterMaxInputChars": 12000,
    "chapterMaxTotalInputChars": 24000,
    "chapterConcurrency": 2,
    "chapterMaxSections": 8,
    "chapterMaxChars": 6000
  },
  "pdf": {
    "title": "Course Companion",
    "subtitle": "",
    "includeCover": true,
    "includeToc": true,
    "pageNumbers": true,
    "pageSize": "A4",
    "style": {
      "name": "Explain to a curious 10-year-old",
      "tonePrompt": "Explain the material for a curious 10-year-old. Use simple words, short paragraphs, and everyday analogies (toys, games, cooking, school). Introduce one idea at a time and define any hard word the first time it appears. Stay accurate: do not invent facts, numbers or names. End each chapter with three short takeaways.",
      "readingLevel": "age 10",
      "fontFamily": "Georgia, 'Times New Roman', serif",
      "headingFontFamily": "Georgia, 'Times New Roman', serif",
      "bodyFontSizePt": 12,
      "lineHeight": 1.5,
      "marginMm": { "top": 20, "right": 18, "bottom": 20, "left": 18 },
      "colors": {
        "ink": "#1f1b16",
        "muted": "#5d554a",
        "paper": "#fffdf8",
        "accent": "#b4482c",
        "rule": "#2a251e"
      },
      "coverBackground": "#f3e9d2",
      "showVideoCitations": true
    }
  },
  "output": { "dir": "output", "pdfName": "course.pdf" },
  "jobs": { "concurrency": 2, "stateWriteIntervalMs": 500, "maxWarnings": 50 }
}
