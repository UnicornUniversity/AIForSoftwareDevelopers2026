# Copy this file to .env and fill in your keys.
# Never commit .env — it is listed in .gitignore.

# DeepSeek — https://platform.deepseek.com/ -> API keys
DEEPSEEK_API_KEY=

# TMDB — https://www.themoviedb.org/settings/api -> API Key (v3 auth)
TMDB_API_KEY=

# LangSmith tracing (optional). The app runs fine without it.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=movie-recommendation-classroom
# Only for a regional LangSmith account, for example:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

PORT=3000
